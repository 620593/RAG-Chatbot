{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://rag-chatbot-api.onrender.com/:path*" },
    { "source": "/upload",     "destination": "https://rag-chatbot-api.onrender.com/upload" },
    { "source": "/chat",       "destination": "https://rag-chatbot-api.onrender.com/chat" },
    { "source": "/health",     "destination": "https://rag-chatbot-api.onrender.com/health" },
    { "source": "/status",     "destination": "https://rag-chatbot-api.onrender.com/status" }
  ]
}
