# ──────────────────────────────────────────────────────────────────────────────
# Enterprise RAG Chatbot — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit the actual .env file to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM (Groq Cloud) ──────────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ── Embeddings (HuggingFace) ──────────────────────────────────────────────────
# Get a token with "Inference" permissions from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5

# ── Vector Store (Qdrant Cloud) ───────────────────────────────────────────────
# Create a free cluster at: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=rag_collection

# ── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────
# In development, leave as "*"
# In production, set to your frontend URL (e.g. https://your-app.vercel.app)
CORS_ORIGINS=*

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
# Set to "false" to skip contextual chunk enrichment (faster but less accurate)
CONTEXTUAL_CHUNKING_ENABLED=true

# Text splitter configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Rate-limit delay between contextual chunking batches (seconds)
CHUNKING_RATE_LIMIT_DELAY=2.0

# Max Groq API retries per chunk on rate-limit errors
GROQ_MAX_RETRIES=4

# Maximum upload file size
MAX_UPLOAD_SIZE_MB=50
